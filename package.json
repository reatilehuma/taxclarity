{
  "name": "taxclarity",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint -c .oxlintrc.json apps packages",
    "e2e": "npm run e2e -w apps/web",
    "e2e:install": "playwright install chromium",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run bundle:check -w apps/web && npm run e2e && npm run release:check",
    "lighthouse": "npm run lighthouse -w apps/web",
    "links:check": "npm run links:check -w apps/web",
    "assistant:smoke": "npm run smoke -w packages/assistant-proxy",
    "release:check": "npm run release:check -w apps/web"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.94.0"
  }
}
